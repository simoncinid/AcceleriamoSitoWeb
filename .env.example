# SMTP Aruba (Vercel env vars). ARUBA_USER è la casella mittente; LEAD_DEST il destinatario fisso dei contatti.
ARUBA_USER=
ARUBA_PASS=
LEAD_DEST=

# Dati pubblici del titolare: completare prima della build di produzione.
LEGAL_BUSINESS_ADDRESS=
NEXT_PUBLIC_SITE_URL=https://acceleriamo.it

# Pixel Meta: ID pubblico. Senza ID il pixel e il banner restano disattivati.
NEXT_PUBLIC_META_PIXEL_ID=
# API Conversioni: segreto solo server; versione Graph supportata dal proprio account (es. vXX.X).
META_CONVERSIONS_ACCESS_TOKEN=
META_GRAPH_API_VERSION=
# Solo per verifica in Gestione eventi, rimuovere in produzione.
META_TEST_EVENT_CODE=

# AI WorkMap: provider OpenAI-compatible con structured outputs JSON Schema.
WORKMAP_AI_BASE_URL=https://api.openai.com/v1
WORKMAP_AI_API_KEY=
WORKMAP_AI_MODEL=
WORKMAP_AI_PROVIDER_NAME=OpenAI
# Impostare true soltanto se il modello accetta temperature.
WORKMAP_AI_TEMPERATURE_SUPPORTED=false
# Redis REST. Usa STORAGE_KV_REST_API_URL (https://...) e STORAGE_KV_REST_API_TOKEN.
# Non usare STORAGE_REDIS_URL / STORAGE_KV_URL (rediss:// con password nell’indirizzo).
WORKMAP_REDIS_URL=
WORKMAP_REDIS_TOKEN=
# Segreto casuale di almeno 32 caratteri per i link privati di recupero.
WORKMAP_ACCESS_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Attivare dopo OpenAI, Redis, Stripe, SMTP e un acquisto di prova.
WORKMAP_SALES_ENABLED=false
# Autenticazione del cron Vercel già definito in vercel.json (GET /api/workmap/worker).
CRON_SECRET=
# Solo sviluppo, opzionale: directory dati locale; non attivare su Vercel.
# WORKMAP_DATA_DIR=.workmap-data
# WORKMAP_ALLOW_LOCAL_STORE=true
